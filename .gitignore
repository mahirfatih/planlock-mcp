# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
uv.lock

# JavaScript tooling (see the optional MCP client probes)
node_modules/
package-lock.json

# Local secrets and env files (keep the example tracked)
.env
.env.*
!.env.example

# Plan Lock MCP runtime state (generated by planlock.py in the working directory)
plan.md
plan.md.bak
.opencode/plan.md
.opencode/plan.md.bak

# Leftover atomic-write temporaries (only possible after a crash mid-write)
.tmp_plan_*
.opencode/.tmp_plan_*

# SAGE / MCP runtime memory state (SQLite WAL/SHM, locks, daemon logs)
.wrongstack/

# Editors and OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
